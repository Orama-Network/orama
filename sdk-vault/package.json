{
  "name": "@orama-network/orama-vault",
  "version": "0.3.11",
  "description": "Client for the Orama Network vault guardians — Shamir-split secret storage for operators and RootWallet",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Orama Network",
  "keywords": [
    "orama",
    "vault",
    "secrets",
    "shamir",
    "guardian",
    "encryption",
    "distributed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orama-Network/orama.git",
    "directory": "sdk-vault"
  },
  "bugs": {
    "url": "https://github.com/Orama-Network/orama/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "release:gitea": "npm publish --registry=https://git.icxcnika.io/api/packages/ICXCNIKA/npm/"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "registry": "https://git.icxcnika.io/api/packages/ICXCNIKA/npm/"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  }
}
