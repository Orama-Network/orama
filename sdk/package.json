{
  "name": "@orama-network/orama",
  "version": "0.3.13",
  "description": "TypeScript SDK for Orama Network - Database, PubSub, Cache, Storage, Functions, and more",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Orama Network",
  "keywords": [
    "network",
    "sdk",
    "typescript",
    "database",
    "rqlite",
    "pubsub",
    "websocket",
    "cache",
    "olric",
    "ipfs",
    "storage",
    "wasm",
    "serverless",
    "distributed",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orama-Network/orama.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/Orama-Network/orama/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chain": {
      "import": {
        "types": "./dist/chain.d.ts",
        "default": "./dist/chain.js"
      },
      "require": {
        "types": "./dist/chain.d.cts",
        "default": "./dist/chain.cjs"
      }
    },
    "./relay": {
      "import": {
        "types": "./dist/relay.d.ts",
        "default": "./dist/relay.js"
      },
      "require": {
        "types": "./dist/relay.d.cts",
        "default": "./dist/relay.cjs"
      }
    },
    "./workload": {
      "import": {
        "types": "./dist/workload.d.ts",
        "default": "./dist/workload.js"
      },
      "require": {
        "types": "./dist/workload.d.cts",
        "default": "./dist/workload.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "gen:chain": "bash scripts/gen-chain-proto.sh",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "example": "tsx examples/basic-usage.ts",
    "release:gitea": "npm publish --registry=https://git.icxcnika.io/api/packages/ICXCNIKA/npm/"
  },
  "dependencies": {
    "isomorphic-ws": "^5.0.0"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.6.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "ws": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    },
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@noble/curves": {
      "optional": true
    },
    "@noble/hashes": {
      "optional": true
    },
    "@scure/base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@eslint/js": "^10.0.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "ts-proto": "2.12.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  },
  "publishConfig": {
    "registry": "https://git.icxcnika.io/api/packages/ICXCNIKA/npm/"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19"
  }
}
